{
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "color",
        "background-color",
        "border-color",
        "border-top-color",
        "border-right-color",
        "border-bottom-color",
        "border-left-color",
        "outline-color",
        "fill",
        "stroke",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "letter-spacing",
        "border-radius",
        "border-top-left-radius",
        "border-top-right-radius",
        "border-bottom-left-radius",
        "border-bottom-right-radius",
        "border-start-start-radius",
        "border-start-end-radius",
        "border-end-start-radius",
        "border-end-end-radius",
        "padding",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "padding-block",
        "padding-block-start",
        "padding-block-end",
        "padding-inline",
        "padding-inline-start",
        "padding-inline-end",
        "margin",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",
        "margin-block",
        "margin-block-start",
        "margin-block-end",
        "margin-inline",
        "margin-inline-start",
        "margin-inline-end",
        "gap",
        "row-gap",
        "column-gap"
      ],
      {
        "ignoreValues": [
          "0",
          "0px",
          "auto",
          "none",
          "transparent",
          "currentColor",
          "inherit",
          "initial",
          "unset",
          "revert"
        ],
        "message": "Use a design token (var(--...)) instead of a raw value here — see docs/foundations/token-governance.json"
      }
    ]
  }
}
