{
  "examples": [
    {
      "name": "Single",
      "jsx": "<Slider label=\"Volume\" defaultValue={50} />"
    },
    {
      "name": "Range",
      "jsx": "<SliderRange label=\"Price\" defaultValue={[25, 75]} />"
    },
    {
      "name": "Centered",
      "jsx": "<SliderCentered label=\"Balance\" defaultValue={0} />"
    },
    {
      "name": "Range in a form, with its own field names",
      "jsx": "<SliderRange label=\"Budget\" name=\"budget\" minName=\"budgetFrom\" maxName=\"budgetTo\" defaultValue={[20, 80]} />"
    },
    {
      "name": "In a Field, with an error",
      "jsx": "<Field label=\"Fee range\" required state=\"error\" message=\"Set a range at least $500 wide.\"><SliderRange min={0} max={5000} step={100} defaultValue={[1000, 1200]} /></Field>"
    },
    {
      "name": "Invalid, with its own label",
      "jsx": "<Slider label=\"Confidence\" invalid aria-describedby=\"confidence-error\" />"
    }
  ]
}