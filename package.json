{
  "name": "design-system",
  "version": "1.0.0",
  "description": "Design system for LegacyHQ",
  "main": "index.js",
  "scripts": {
    "build": "style-dictionary build -c style-dictionary.config.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:registry": "node scripts/generate-component-registry.mjs",
    "generate:exemplars": "node scripts/generate-component-exemplars.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"packages/ui/src/components/**/*.module.css\"",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run lint && npm run lint:css && npm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "\"design",
    "tokens\"",
    "\"design",
    "system\"",
    "\"legacyhq\""
  ],
  "author": "benjamin averill",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.2.8",
    "style-dictionary": "^5.0.0",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "sass": "^1.97.0"
  }
}
