{
  "Semantic: Motion": {
    "fade-quick": {
      "$type": "transition",
      "$value": {
        "duration": "{Primitive.Value.duration-fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{Primitive.Value.ease-standard}"
      },
      "$extensions": {
        "com.legacyhq": {
          "originalName": "fade/quick"
        }
      }
    },
    "fade-long": {
      "$type": "transition",
      "$value": {
        "duration": "{Primitive.Value.duration-slow}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{Primitive.Value.ease-standard}"
      },
      "$extensions": {
        "com.legacyhq": {
          "originalName": "fade/long"
        }
      }
    },
    "move-quick": {
      "$type": "transition",
      "$value": {
        "duration": "{Primitive.Value.duration-fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{Primitive.Value.ease-spring}"
      },
      "$extensions": {
        "com.legacyhq": {
          "originalName": "move/quick"
        }
      }
    },
    "move-long": {
      "$type": "transition",
      "$value": {
        "duration": "{Primitive.Value.duration-slow}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{Primitive.Value.ease-spring}"
      },
      "$extensions": {
        "com.legacyhq": {
          "originalName": "move/long"
        }
      }
    },
    "spin-loop": {
      "$extensions": {
        "com.legacyhq": {
          "originalName": "spin/loop"
        }
      },
      "duration": {
        "$type": "duration",
        "$value": "{Primitive.Value.duration-loop}"
      },
      "timingFunction": {
        "$type": "cubicBezier",
        "$value": "{Primitive.Value.ease-loop}"
      }
    },
    "pulse-loop": {
      "$extensions": {
        "com.legacyhq": {
          "originalName": "pulse/loop"
        }
      },
      "duration": {
        "$type": "duration",
        "$value": "{Primitive.Value.duration-loop-slow}"
      },
      "timingFunction": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    }
  }
}
